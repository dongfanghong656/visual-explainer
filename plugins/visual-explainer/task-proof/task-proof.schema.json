{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://visual-explainer.local/schemas/task-proof-0.2.0.json",
  "title": "Task Proof artifacts",
  "oneOf": [
    { "$ref": "#/$defs/claim" },
    { "$ref": "#/$defs/review" },
    { "$ref": "#/$defs/snapshot" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-fA-F]{64}$"
    },
    "evidenceKind": {
      "enum": ["commit", "diffstat", "file", "test", "build", "trace", "manual", "external"]
    },
    "criterion": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1 },
        "requiredEvidenceKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/evidenceKind" }
        }
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": [
        "issuer",
        "snapshotDigest",
        "evidenceId",
        "supportsClaimIds",
        "supportsCriterionIds",
        "observation",
        "receiptDigest"
      ],
      "properties": {
        "issuer": { "const": "visual-explainer-task-proof-mcp" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "evidenceId": { "$ref": "#/$defs/id" },
        "supportsClaimIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "supportsCriterionIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "observation": { "type": "object" },
        "receiptDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "locator", "producerRunId", "trust"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/evidenceKind" },
        "locator": { "type": "string", "minLength": 1 },
        "observedAt": { "type": "string", "format": "date-time" },
        "digest": { "$ref": "#/$defs/digest" },
        "producerRunId": { "$ref": "#/$defs/id" },
        "trust": { "enum": ["self_report", "artifact", "deterministic", "independent", "external"] },
        "result": {
          "type": "object",
          "properties": {
            "exitCode": { "type": "integer" },
            "summary": { "type": "string" }
          },
          "additionalProperties": true
        },
        "receipt": { "$ref": "#/$defs/receipt" }
      },
      "additionalProperties": true
    },
    "repositoryBinding": {
      "type": "object",
      "required": ["branch", "baseSha", "headSha", "snapshotDigest"],
      "properties": {
        "branch": { "type": "string", "minLength": 1 },
        "baseSha": { "$ref": "#/$defs/sha" },
        "headSha": { "$ref": "#/$defs/sha" },
        "dirty": { "type": "boolean" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "staleAgainstClaim": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "task": {
      "type": "object",
      "required": ["id", "title", "objective", "acceptanceCriteria"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "objective": { "type": "string", "minLength": 1 },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "$ref": "#/$defs/criterion" }
        }
      },
      "additionalProperties": true
    },
    "claimItem": {
      "type": "object",
      "required": ["id", "statement", "declaredStatus", "acceptanceCriteriaIds", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "statement": { "type": "string", "minLength": 1 },
        "declaredStatus": { "enum": ["declared_done", "partial", "blocked", "not_done"] },
        "acceptanceCriteriaIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "evidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "not": {
        "anyOf": [
          { "required": ["verified"] },
          { "required": ["verdict"] },
          { "required": ["gate"] },
          { "required": ["completionGate"] }
        ]
      },
      "additionalProperties": true
    },
    "claim": {
      "type": "object",
      "required": [
        "protocolVersion",
        "kind",
        "id",
        "generatedAt",
        "producer",
        "repository",
        "task",
        "claims",
        "evidence"
      ],
      "properties": {
        "protocolVersion": { "const": "0.2.0" },
        "kind": { "const": "task-proof/claim" },
        "id": { "$ref": "#/$defs/id" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "producer": {
          "type": "object",
          "required": ["runId", "role"],
          "properties": {
            "runId": { "$ref": "#/$defs/id" },
            "role": { "const": "claimant" },
            "agent": { "type": "string" },
            "model": { "type": "string" }
          },
          "additionalProperties": true
        },
        "repository": { "$ref": "#/$defs/repositoryBinding" },
        "task": { "$ref": "#/$defs/task" },
        "change": { "type": "object", "additionalProperties": true },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/claimItem" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "risks": { "type": "array" },
        "unknowns": { "type": "array" },
        "nextSteps": { "type": "array" }
      },
      "additionalProperties": true
    },
    "finding": {
      "type": "object",
      "required": ["claimId", "declaredStatus", "verdict", "rationale", "reviewEvidenceIds"],
      "properties": {
        "claimId": { "$ref": "#/$defs/id" },
        "declaredStatus": { "enum": ["declared_done", "partial", "blocked", "not_done"] },
        "verdict": { "enum": ["verified", "partially_verified", "unsupported", "contradicted", "stale", "not_applicable"] },
        "rationale": { "type": "string", "minLength": 1 },
        "reviewEvidenceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "reviewEvidence": {
      "allOf": [
        { "$ref": "#/$defs/evidence" },
        { "required": ["receipt"] }
      ]
    },
    "review": {
      "type": "object",
      "required": [
        "protocolVersion",
        "kind",
        "id",
        "generatedAt",
        "reviewer",
        "claimId",
        "claimDigest",
        "repository",
        "task",
        "claims",
        "findings",
        "reviewEvidence",
        "gate",
        "artifactDigest"
      ],
      "properties": {
        "protocolVersion": { "const": "0.2.0" },
        "kind": { "const": "task-proof/review" },
        "id": { "$ref": "#/$defs/id" },
        "generatedAt": { "type": "string", "format": "date-time" },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "reviewer": {
          "type": "object",
          "required": ["runId", "role"],
          "properties": {
            "runId": { "$ref": "#/$defs/id" },
            "role": { "const": "reviewer" },
            "agent": { "type": "string" },
            "model": { "type": "string" }
          },
          "additionalProperties": true
        },
        "claimId": { "$ref": "#/$defs/id" },
        "claimDigest": { "$ref": "#/$defs/digest" },
        "repository": { "$ref": "#/$defs/repositoryBinding" },
        "task": { "$ref": "#/$defs/task" },
        "change": { "type": "object", "additionalProperties": true },
        "claims": {
          "type": "array",
          "items": { "$ref": "#/$defs/claimItem" }
        },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        },
        "reviewEvidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/reviewEvidence" }
        },
        "gate": {
          "type": "object",
          "required": ["status", "verifiedClaimIds", "rejectedClaimIds", "staleClaimIds", "rule"],
          "properties": {
            "status": { "enum": ["PASS", "PASS_WITH_LIMITS", "FAIL", "INCONCLUSIVE"] },
            "verifiedClaimIds": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "rejectedClaimIds": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "staleClaimIds": {
              "type": "array",
              "items": { "$ref": "#/$defs/id" }
            },
            "rule": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "snapshot": {
      "type": "object",
      "required": ["protocolVersion", "kind", "observedAt", "repository", "snapshotDigest"],
      "properties": {
        "protocolVersion": { "const": "0.2.0" },
        "kind": { "const": "task-proof/snapshot" },
        "observedAt": { "type": "string", "format": "date-time" },
        "repository": {
          "type": "object",
          "required": ["branch", "baseSha", "headSha", "dirty"],
          "additionalProperties": true
        },
        "snapshotDigest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
