{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dongfanghong656/visual-explainer/task-proof/task-contract-2.3.0.schema.json",
  "title": "Task Proof frozen task contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "contractId", "taskId", "repository", "authority", "sources", "scope", "requirements", "criteria", "evidencePolicies", "reviewPolicy", "lifecycle", "amendment"],
  "properties": {
    "schemaVersion": { "const": "2.3.0" },
    "kind": { "const": "task-contract" },
    "contractId": { "$ref": "#/$defs/stableId" },
    "taskId": { "$ref": "#/$defs/stableId" },
    "repository": { "type": "string", "minLength": 1, "maxLength": 512 },
    "authority": { "$ref": "#/$defs/authority" },
    "sources": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/source" } },
    "scope": { "$ref": "#/$defs/scope" },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/sourceRequirement" } },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "contains": { "type": "object", "required": ["criticality"], "properties": { "criticality": { "const": "blocking" } } },
      "items": { "$ref": "#/$defs/criterion" }
    },
    "evidencePolicies": { "$ref": "#/$defs/evidencePolicies" },
    "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" },
    "lifecycle": { "$ref": "#/$defs/lifecycle" },
    "amendment": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/amendment" }] }
  },
  "$defs": {
    "stableId": { "type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9._:-]{1,127}$" },
    "gitOid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "sha256": { "type": "string", "pattern": "^(?:sha256:)?[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "allOf": [
        { "not": { "pattern": "^(?:/|//|[A-Za-z]:[/\\\\])" } },
        { "not": { "pattern": "(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)" } },
        { "not": { "pattern": "(?:^|[/\\\\])\\.git(?:[/\\\\]|$)" } }
      ]
    },
    "stringSet": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "issuerRole", "issuerRunId", "method", "issuedAt", "signature", "keyId", "limitations"],
      "properties": {
        "level": { "enum": ["claimant_provisional", "user_attested", "project_approved", "issue_locked", "release_policy"] },
        "issuerRole": { "type": "string", "minLength": 1, "maxLength": 128 },
        "issuerRunId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "method": { "enum": ["procedural_attestation", "repository_source", "host_message_attestation", "github_issue_live", "release_registry_live", "cryptographic_signature"] },
        "issuedAt": { "type": "string", "format": "date-time" },
        "signature": { "type": ["string", "null"], "maxLength": 16384 },
        "keyId": { "type": ["string", "null"], "maxLength": 512 },
        "limitations": { "$ref": "#/$defs/stringSet" }
      },
      "allOf": [{
        "if": { "properties": { "method": { "const": "cryptographic_signature" } } },
        "then": { "properties": { "signature": { "type": "string", "minLength": 1 }, "keyId": { "type": "string", "minLength": 1 } } }
      }]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "type", "locator", "revision", "sha256", "precedence", "description", "assurance"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/stableId" },
        "type": { "enum": ["repository_file", "user_message", "github_issue", "release_policy"] },
        "locator": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "revision": { "type": ["string", "null"], "maxLength": 128 },
        "sha256": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "precedence": { "type": "integer", "minimum": 0, "maximum": 10000 },
        "description": { "type": ["string", "null"], "maxLength": 4096 },
        "assurance": { "type": ["string", "null"], "maxLength": 128 }
      },
      "allOf": [{
        "if": { "properties": { "type": { "const": "repository_file" } } },
        "then": { "properties": { "locator": { "$ref": "#/$defs/repositoryPath" }, "revision": { "$ref": "#/$defs/gitOid" }, "sha256": { "$ref": "#/$defs/sha256" } } }
      }]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseRevision", "includedOutcomes", "excludedOutcomes", "includedPaths", "excludedPaths"],
      "properties": {
        "baseRevision": { "$ref": "#/$defs/gitOid" },
        "includedOutcomes": { "allOf": [{ "$ref": "#/$defs/stringSet" }, { "minItems": 1 }] },
        "excludedOutcomes": { "$ref": "#/$defs/stringSet" },
        "includedPaths": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } },
        "excludedPaths": { "type": "array", "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/repositoryPath" } }
      }
    },
    "sourceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "sourceId", "statement", "disposition", "criterionIds", "authorityReason"],
      "properties": {
        "requirementId": { "$ref": "#/$defs/stableId" },
        "sourceId": { "$ref": "#/$defs/stableId" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "disposition": { "enum": ["covered", "explicitly_excluded", "deferred_with_authority", "superseded"] },
        "criterionIds": { "type": "array", "maxItems": 128, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "authorityReason": { "type": ["string", "null"], "maxLength": 8192 }
      },
      "allOf": [{
        "if": { "properties": { "disposition": { "const": "covered" } } },
        "then": { "properties": { "criterionIds": { "minItems": 1 } } },
        "else": { "properties": { "authorityReason": { "type": "string", "minLength": 1 } } }
      }]
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "criticality", "requiredEvidenceKinds", "requiredEvidenceLocators", "sourceRequirementRefs", "environment", "limitations"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "statement": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "criticality": { "enum": ["blocking", "non_blocking", "advisory"] },
        "requiredEvidenceKinds": { "$ref": "#/$defs/stringSet" },
        "requiredEvidenceLocators": { "$ref": "#/$defs/stringSet" },
        "sourceRequirementRefs": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "$ref": "#/$defs/stableId" } },
        "environment": { "type": ["string", "null"], "maxLength": 2048 },
        "limitations": { "$ref": "#/$defs/stringSet" }
      },
      "allOf": [{
        "if": { "properties": { "criticality": { "const": "blocking" } } },
        "then": { "properties": { "requiredEvidenceKinds": { "minItems": 1 }, "requiredEvidenceLocators": { "minItems": 1 } } }
      }]
    },
    "namedCheckPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "policyDigest", "evidenceKind", "executableDigest", "argsDigest", "workingDirectory"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$" },
        "policyDigest": { "$ref": "#/$defs/sha256" },
        "evidenceKind": { "type": "string", "minLength": 1, "maxLength": 128 },
        "executableDigest": { "$ref": "#/$defs/sha256" },
        "argsDigest": { "$ref": "#/$defs/sha256" },
        "workingDirectory": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "evidencePolicies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namedChecks"],
      "properties": { "namedChecks": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/namedCheckPolicy" } } }
    },
    "reviewPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumIndependence", "allBlockingCriteriaRequired", "allowClaimantProvisionalContract"],
      "properties": {
        "minimumIndependence": { "enum": ["R0", "R1", "R2", "R3"] },
        "allBlockingCriteriaRequired": { "type": "boolean" },
        "allowClaimantProvisionalContract": { "type": "boolean" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "supersededByContractId", "supersededByContractDigest", "revokedReason"],
      "properties": {
        "status": { "enum": ["active", "superseded", "revoked"] },
        "supersededByContractId": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/stableId" }] },
        "supersededByContractDigest": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha256" }] },
        "revokedReason": { "type": ["string", "null"], "maxLength": 8192 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "superseded" } } },
          "then": { "properties": { "supersededByContractId": { "$ref": "#/$defs/stableId" }, "supersededByContractDigest": { "$ref": "#/$defs/sha256" } } }
        },
        {
          "if": { "properties": { "status": { "const": "revoked" } } },
          "then": { "properties": { "revokedReason": { "type": "string", "minLength": 1 } } }
        }
      ]
    },
    "amendment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previousContractId", "previousContractDigest", "reason", "authorizedByReceiptDigest", "effectiveAtRevision"],
      "properties": {
        "previousContractId": { "$ref": "#/$defs/stableId" },
        "previousContractDigest": { "$ref": "#/$defs/sha256" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "authorizedByReceiptDigest": { "$ref": "#/$defs/sha256" },
        "effectiveAtRevision": { "$ref": "#/$defs/gitOid" }
      }
    }
  }
}
